; RCMAKER 完整环境配置参考。默认仅用 SQLite、文件缓存、文件 Session。
; 不要求外部数据库、Redis 或可选 ORM；PHP 需启用 pdo_sqlite。
; 分号开头为注释；可选路径默认不设置，启用时填写绝对路径，不要留空或写 null。
; true / false 不加引号；字符串可加引号；数组逐行使用 key[] = value。
; 修改后重启服务。升级时逐项合并，不要用示例覆盖已有 .env。

; ===== 应用 =====
[app]
start_app = true
cli_log = false
debug = false
default_timezone = Asia/Shanghai
memory_limit = 256M
count = false
error_msg = 'Server error'
route = true
with_custom_route = false
index[] = index
index[] = index
default_app = index
route_cache_limit = 1024
trusted_proxy_header = x-forwarded-for
; 只信任实际使用的反向代理，不配置则只读取连接 IP。
; trusted_proxies[] = 127.0.0.1
; trusted_proxies[] = 10.0.0.0/8
; public_path = /srv/my-app/public
; runtime_path = /srv/my-app/runtime
; ssl_path = /srv/my-app/ssl
; apps_path = /srv/my-app/apps
; view_path = /srv/my-app/view

; ===== 主 APP 进程组 =====
[workerman]
; 默认只监听本机，正式对外部署时按需改成 http://0.0.0.0:8680。
listen = 'http://127.0.0.1:8680'
name = RC_WORKER
count = 1
; 仅 Windows 生效；大于 1 的监听组需要 sockets 扩展，Linux 使用 count。
windows_count = 1
transport = tcp
reusePort = true
user = ''
group = ''
max_request = 1000000
max_package_size = 10485760
enable_static_file = true
enable_static_php = false
enable_static_gzip = true
enable_static_preload = true
static_preload_time_limit = 0.5
static_preload_extensions[] = css
static_preload_extensions[] = js
static_preload_extensions[] = html
static_preload_extensions[] = htm
static_preload_extensions[] = json
static_preload_extensions[] = svg
static_preload_extensions[] = txt
static_preload_extensions[] = xml
index_default = index.html
logger_listen = 'text://127.0.0.1:8689'
; 以下未设置时跟随 public_path() / runtime_path()，保持源码及 PHAR 路径兼容。
; document_root = /srv/my-app/public
; pid_file = /srv/my-app/runtime/RC_Workerman.pid
; log_file = /srv/my-app/runtime/RC_Workerman_Log.log
; status_file = /srv/my-app/runtime/RC_Workerman_Status.log
; stdout_file = /srv/my-app/runtime/logs/RC_Workerman_Stdout.log

; ===== 组件初始化 =====
[bootstrap]
; 完整列表替换而非追加；使用其他 ORM / Redis 时在此按需增加，并先安装所需扩展或稳定依赖。
; 初始化由框架完成，业务模型不要再次调用 Medoo::start() 等方法。
load[] = RC\Session
load[] = RC\Helper\Cache\Raw
load[] = RC\Helper\Db\Medoo

; ===== 数据库 =====
[db]
default_frame = medoo
default = sqlite

[sqlite]
; 默认 phar_path() . '/data/database/rcmaker.sqlite'，持久数据不可随 runtime 清理。
; database = /srv/my-app/data/database/rcmaker.sqlite
prefix = ''

[mysql]
host = 127.0.0.1
port = 3306
database = ''
username = ''
password = ''
charset = utf8mb4
prefix = ''

[pgsql]
host = 127.0.0.1
port = 5432
database = ''
username = ''
password = ''
prefix = ''

; ===== 缓存 =====
[cache]
default_frame = raw
default = file
prefix = RCCache_
expire = 0
redis_database = 0
; file_path = /srv/my-app/runtime/cache/

; ===== Redis =====
[redis]
; 仅按需使用，不因本节存在就连接 Redis。原生扩展或稳定版 Predis 至少具备一种。
default_frame = raw
type = common
host = 127.0.0.1
port = 6379
password = ''
database = 0
timeout = 5
retryInterval = 0
readTimeout = 5
persistent = false
select = x
prefix = ''

; ===== Session =====
[session]
handler = RC\Http\FileSessionHandler
session_name = PHPSID
; 改用 Redis 时 handler = RC\Http\RedisSessionHandler，连接复用 [redis] 的地址和密码。
redis_database = 0
redis_prefix = 'RC:SESSION:'
; save_path = /srv/my-app/runtime/sessions

; ===== Redis 队列 =====
[queue]
; 还需在 config/queue.php 配置 consumer_process；默认不创建消费者进程。
enable = false
redis_database = 0
prefix = ''
max_attempts = 5
retry_seconds = 5

; ===== JWT / Token =====
[token]
; default 对应 config/token.php 的 api 连接，新增鉴权连接在该文件配置。
default = api
signer = HS256
type = Bearer
key_name = token
; 使用独立、足够长的随机密钥。留空时拒绝签发，不提供通用演示密钥。
access_secret_key = ''
access_expired = 7200
refresh_secret_key = ''
refresh_expired = 604800
refresh_disable = false
iss = rcmaker
leeway = 60
is_single_device = true
cache_token_time = 604800
cache_token_prefix = 'RC:AUTH:TOKEN:'
; 非对称算法的 access_private_key / access_public_key、refresh_private_key / refresh_public_key
; 在 config/token.php 中按框架组件要求载入；密钥对可通过 php index.php interact 生成。

; ===== 本地图形 / 离线滑块验证码 =====
[captcha]
provider = image
expire = 300
name_prefix = RC_CAPTCHA_
; 以下为图形验证码参数；默认需要 GD、FreeType 及相应图片格式支持。
length = 5
store = cache
image_width = 150
image_height = 40
charset = abcdefghijklmnpqrstuvwxyz123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ
auto_delete = true
return = image
; font = /srv/my-app/data/fonts/captcha.ttf
; 以下为 provider=slider 时的参数，滑块只使用框架缓存，不能关闭防重放和限流。
token_expire = 60
width = 280
height = 160
tolerance = 3
rate_window = 60
rate_max_requests = 30
; backgrounds[] = /srv/my-app/public/captcha/background.jpg

; ===== 短信验证码校验，不包含实际供应商发送实现 =====
[sms]
type = 1
length = 4
expire = 180
ip_check = true
mobile_key = mobile
code_key = code
auto_delete = true

; ===== 邮件，按需使用；默认启动不会连接 SMTP =====
[mailer]
driver = smtp
host = ''
smtp_auth = true
username = ''
password = ''
encryption = tls
port = 587
debug = 0
debug_output = error_log
exceptions = true
language = zh_cn
charset = utf-8

; ===== 视图 =====
[view]
handler = RC\Helper\View\Raw
suffix = html

; ===== HTTPS 上下文 =====
[ssl]
; 默认仍是 HTTP / tcp，不因本节存在启用 TLS；启用时配置有效的证书及 transport。
; local_cert = /srv/my-app/ssl/server.crt
; local_pk = /srv/my-app/ssl/server.key
verify_peer = false
allow_self_signed = false

; ===== 必须在 PHP 配置中维护的项目级结构，不是 .env 键 =====
; config/app.php：cli_frame、cli_banner、error_types、app_name；多应用 app、domains、bind_process、static_only 等。
; cli_banner 只由开发者提前设定，不允许部署者通过 .env 修改。
; config/banner.php：Banner 行、颜色、变量、进程列表。
; config/autoload.php：公共函数文件列表；config/bootstrap.php：上述 bootstrap.load 的缺省列表。
; config/process.php：独立 APP / 静态 APP / 后台进程及各组端口、资源和重启策略。
; config/route.php、middleware.php、exception.php：路由、中间件、异常处理类。
; config/db.php：驱动列表、PDO options 和项目自定义连接。
; config/cache.php、redis.php、session.php：更多缓存、集群和 Session 连接。
; config/queue.php：消费者进程、连接及高级传输限制。
; config/token.php：额外鉴权连接、非对称密钥、提示信息。
; config/captcha.php：额外连接、图形 fingerprint、定制图片行为。
; config/view.php：不同模板引擎的 options；config/mailer.php、sms.php：更多连接及业务扩展。
; config/static_encryption.php：静态保护 profiles、applications；建议通过 interact 管理。
; config/build.php：二进制组件选择，默认完整打包；只影响构建，不通过 .env 控制。
